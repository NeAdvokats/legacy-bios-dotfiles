configuration {
    modi: "run";
    font: "PxPlus IBM VGA 8x16 16";
    show-icons: false;
    terminal: "alacritty";
    run-display-format: "{name}";
    location: 0;
    disable-history: true;
}

* {
    bios-blue:   #00009c;
    bios-white:  #ffffff;
    bios-black:  #000000;

    background-color: transparent;
    text-color:       @bios-white;
}

window {
    background-color: @bios-blue;
    padding:          0px;
    width:            400px;
    border:           0px;
}

mainbox {
    border:           0px;
    padding:          0px;
    background-color: @bios-blue;
    children:         [ listview ];
}

listview {
    fixed-height:     0;
    border:           0px;
    spacing:          0px;
    scrollbar:        false;
    padding:          12px;
    lines:            5;
    background-color: @bios-blue;
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: @bios-blue;
    text-color:       @bios-white;
}

element {
    padding:          2px 0px;
    background-color: @bios-blue;
    text-color:       @bios-white;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    expand:           true;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @bios-black;
    text-color:       @bios-white;
}
